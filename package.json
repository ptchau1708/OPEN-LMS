{
  "name": "open-edu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:learner": "pnpm --filter @openedu/learner dev",
    "dev:teacher": "pnpm --filter @openedu/teacher dev",
    "dev:present": "pnpm --filter @openedu/present dev",
    "relay": "node tools/live-relay/server.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "e2e": "node tools/e2e.mjs",
    "lint": "eslint ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.72.2"
  }
}
