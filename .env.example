# Để trống hai dòng Supabase để chạy chế độ demo (không cần server).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# demo | (để trống = tự chọn theo hai dòng trên)
VITE_DATA_MODE=
# Máy chủ trực tiếp ở chế độ demo (mặc định ws://<tên máy>:8787)
VITE_RELAY_URL=
# Origin nội dung riêng phát gói HTML5 (mặc định http://localhost:5180/)
VITE_CONTENT_ORIGIN=
# Địa chỉ app học sinh và màn hình lớp (để GV tạo mã QR, link TV)
VITE_LEARNER_URL=
VITE_PRESENT_URL=
VITE_STUDENT_EMAIL_DOMAIN=openlms.edu
# Google Classroom (nhập danh sách, đẩy điểm) — OAuth Client ID kiểu "Web application". Để trống = chỉ có nút Chia sẻ.
VITE_GOOGLE_CLIENT_ID=
